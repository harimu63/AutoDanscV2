#!/bin/bash
# Menu VMess - by GEN

GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
NC='\e[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}              ⚙️ MENU VMESS XRAY              ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun VMess"
echo -e "${GREEN}[2]${NC} Trial VMess (60 menit) ⏰"
echo -e "${GREEN}[3]${NC} Hapus Akun VMess"
echo -e "${GREEN}[4]${NC} Cek Login VMess"
echo -e "${GREEN}[5]${NC} Perpanjang Masa Aktif Akun"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -p "👉 Pilih opsi: " opt

case $opt in
1)
bash /etc/danautoscript/xray/add-vmess.sh
;;

2)
bash /etc/danautoscript/xray/trial-vmess.sh
;;

3)
bash /etc/danautoscript/xray/del-vmess.sh
;;

4)
bash /etc/danautoscript/xray/cek-vmess.sh
;;

5)
bash /etc/danautoscript/xray/renew-vmess.sh
;;

x)
menu
;;

*)
echo "❌ Pilihan salah!"
sleep 1
exec m-vmess
;;
esac
