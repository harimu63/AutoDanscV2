#!/bin/bash
# Menu Tools by GEN

# Warna
CYAN='\e[1;36m'
GREEN='\e[1;32m'
YELLOW='\e[1;33m'
NC='\e[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}                 ⚙️ MENU TOOLS                  ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Backup & Restore Config"
echo -e "${GREEN}[2]${NC} Speedtest VPS"
echo -e "${GREEN}[3]${NC} Ganti Domain + Auto SSL"
echo -e "${GREEN}[4]${NC} Cek status layanan aktif"
echo -e "${GREEN}[5]${NC} Update Danautoscript"
echo -e "${GREEN}[6]${NC} Verify SSL Certificate"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -p "👉 Pilih opsi: " opt

case $opt in
1) bash /etc/danautoscript/tools/backup.sh ;;
2) bash /etc/danautoscript/tools/speedtest.sh ;;
3) bash /etc/danautoscript/tools/domain.sh ;;
4) bash /etc/danautoscript/tools/running.sh ;;
5) bash /etc/danautoscript/tools/update.sh ;;
6) bash /etc/danautoscript/tools/verify-ssl.sh ;;
x) menu ;;
*) echo "❌ Pilihan salah!" ; sleep 1 ; tools-menu ;;
esac
